{
  "name": "familycfo",
  "version": "1.0.0",
  "description": "FamilyCFO — a local, read-only money dashboard for an Israeli household: bank balances, investments and expenses over time.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "patch-package && npm --prefix web install",
    "scrape": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "dev": "concurrently -n api,web -c blue,green \"npm run server\" \"npm --prefix web run dev\"",
    "server": "tsx watch src/server/index.ts",
    "web": "npm --prefix web run dev",
    "link": "tsx src/link.ts",
    "pipeline": "tsx src/pipeline.ts",
    "categorize": "tsx src/categorize/cli.ts",
    "import": "tsx src/reports/cli.ts",
    "reports:reextract": "tsx src/reports/reextract.ts",
    "schedule:install": "scripts/schedule.sh install",
    "schedule:uninstall": "scripts/schedule.sh uninstall",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "better-sqlite3": "^11.7.0",
    "fast-xml-parser": "^4.5.7",
    "fastify": "^5.12.5",
    "israeli-bank-scrapers": "^6.12.2",
    "node-cron": "^3.0.3",
    "puppeteer": "^24.37.1",
    "read-excel-file": "^9.3.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "concurrently": "^9.2.1",
    "patch-package": "^8.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.2"
  },
  "overrides": {
    "israeli-bank-scrapers": {
      "puppeteer": "$puppeteer"
    }
  },
  "optionalDependencies": {
    "ccxt": "^4.5.85"
  }
}
