+function fetchPostWithMtls(url, headers, body, clientCert) {
+  return new Promise((resolve, reject) => {
+    const request = require('https').request(url, {
+      method: 'POST',
+      headers: { ...headers, 'Content-Length': Buffer.byteLength(body) },
+      ...clientCert
